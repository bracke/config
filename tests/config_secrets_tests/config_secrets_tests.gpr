with "config/config_secrets_tests_config.gpr";
project Config_Secrets_Tests is
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Config_Secrets_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use Config_Secrets_Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;
   package Binder is for Switches ("Ada") use ("-Es"); end Binder;
end Config_Secrets_Tests;
