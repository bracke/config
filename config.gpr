with "config/config_config.gpr";
project Config is

   for Library_Name use "Config";
   for Library_Version use
     Project'Library_Name & ".so." & Config_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Config_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("CONFIG_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Ada 2022, wide lines, GNAT extensions, and runtime assertions /
      --  contracts (-gnata) enabled in development so internal invariants are
      --  checked during tests.
      for Default_Switches ("Ada") use Config_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Config;
